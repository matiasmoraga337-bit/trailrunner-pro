# Clave de la API de Google AI Studio (Gemini).
# Obtener gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo por defecto para analisis de tramos (rapido / barato).
# Si la cuota de flash se agota, proba con flash-lite (cuotas independientes).
GEMINI_MODEL_FLASH=gemini-2.0-flash-lite

# Modelo para planes estratégicos complejos (opcional).
GEMINI_MODEL_PRO=gemini-2.5-pro