# Proveedor de IA. Opciones:
#   ollama    -> IA local con Ollama (gratis, offline, requiere Docker)
#   gemini    -> Google Gemini (API key gratuita en https://aistudio.google.com/apikey)
#   (vacio)   -> Modo baseline determinista (sin IA, sin API key)
AI_PROVIDER=ollama

# --- Ollama (IA local) ---
# Modelo sugerido. Otros: mistral:7b, gemma2:9b, deepseek-r1:8b
OLLAMA_MODEL=llama3.2:3b

# --- Gemini (solo si AI_PROVIDER=gemini) ---
# Clave de la API de Google AI Studio (Gemini).
# Obtener gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo por defecto para analisis de tramos (rapido / barato).
GEMINI_MODEL_FLASH=gemini-2.0-flash-lite

# Modelo para planes estrategicos complejos (opcional).
GEMINI_MODEL_PRO=gemini-2.5-pro