# Clave de la API de Google AI Studio (Gemini).
# Obtener gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo por defecto para análisis de tramos (rápido/barato).
GEMINI_MODEL_FLASH=gemini-2.0-flash

# Modelo para planes estratégicos complejos (opcional).
GEMINI_MODEL_PRO=gemini-2.5-pro